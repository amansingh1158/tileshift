{
  "name": "2048-puzzle",
  "version": "1.0.0",
  "description": "2048 puzzle game — classic slide-and-merge, multiple board sizes, offline-first",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "serve": "npx http-server app -c-1 -p 8080",
    "assets": "node scripts/make-icon.js",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "android:apk": "cd android && gradlew.bat assembleDebug",
    "android:aab": "cd android && gradlew.bat bundleRelease"
  },
  "keywords": [
    "2048",
    "puzzle",
    "game"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
